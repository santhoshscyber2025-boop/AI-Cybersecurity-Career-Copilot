@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--bg:#0a0f18;--panel:#111a27;--line:#243246;--text:#f1f5fb;--muted:#a1b0c3;--accent:#7cf4c5;--blue:#8ab4ff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Manrope,Arial,sans-serif;line-height:1.6}
.hero{padding:76px 8vw 84px;background:radial-gradient(ellipse at 80% 10%,#1d3c47 0,transparent 38%),linear-gradient(140deg,#0b111c,#101d2b);border-bottom:1px solid var(--line)}
.badge,.eyebrow,.mini-label{font:500 11px 'DM Mono',monospace;letter-spacing:1.8px;color:var(--accent)}.badge{display:inline-block;border:1px solid #326b5d;border-radius:20px;padding:7px 12px}
h1{font-size:clamp(42px,7vw,76px);line-height:1.04;letter-spacing:-3px;margin:25px 0 18px}h1 span{color:var(--accent)}.hero p{max-width:620px;color:var(--muted);font-size:17px}.jump{display:inline-block;margin-top:20px;color:var(--bg);background:var(--accent);padding:12px 18px;border-radius:8px;text-decoration:none;font-weight:800}
main{max-width:1120px;margin:auto;padding:50px 24px}.panel,.roadmap-box{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:clamp(22px,4vw,42px)}
.section-heading{display:flex;gap:25px;justify-content:space-between;align-items:end;margin-bottom:30px}.section-heading h2,.results h2,.info h2{margin:6px 0 0;font-size:clamp(24px,3vw,34px);letter-spacing:-1px}.section-heading>p{max-width:330px;color:var(--muted);font-size:14px}
.field-label{display:block;font-size:14px;font-weight:800;margin:24px 0 10px}.field-label span{font-weight:400;color:var(--muted)}select,input:not([type=checkbox]){width:100%;padding:13px 14px;border-radius:8px;border:1px solid var(--line);background:#0b121d;color:var(--text);font:inherit}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.choice{display:flex;align-items:flex-start;gap:12px;border:1px solid var(--line);border-radius:10px;padding:14px;cursor:pointer;background:#0d1520}.choice:has(input:checked){border-color:var(--accent);background:#102820}.choice input{accent-color:var(--accent);margin-top:5px}.choice b{display:block;font-size:14px}.choice small{display:block;color:var(--muted);font-size:11px;margin-top:3px}
button{font:inherit;cursor:pointer}.panel button{width:100%;margin-top:25px;border:0;border-radius:9px;padding:15px;background:var(--accent);font-weight:800;color:#07120f}.panel button span{float:right}
.results{padding:55px 0}.goal{color:var(--muted)}.role-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:25px 0 35px}.role-card{padding:22px;background:#101925;border:1px solid var(--line);border-radius:14px}.role-top{display:flex;justify-content:space-between;align-items:center}.role-tag{font:11px 'DM Mono',monospace;color:var(--accent);background:#17372e;border-radius:20px;padding:5px 9px}.number{font:12px 'DM Mono',monospace;color:#617187}.role-card h3{font-size:20px;margin:20px 0 8px}.role-card p,.step p,.info p{color:var(--muted);font-size:13px}.mini-label{margin-top:20px;font-size:9px}.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.tags span{border:1px solid #2b3b4f;border-radius:5px;padding:4px 7px;font-size:10px;color:#c3cfde}
.roadmap-box h2{margin-bottom:25px}.timeline{border-left:1px solid #38534d;margin-left:8px}.step{display:grid;grid-template-columns:125px 1fr;gap:20px;padding:0 0 24px 23px;position:relative}.step:before{content:"";position:absolute;left:-5px;top:7px;width:9px;height:9px;border-radius:50%;background:var(--accent)}.week{font:11px 'DM Mono',monospace;color:var(--accent);padding-top:4px}.step h3{margin:0;font-size:16px}.step p{margin:5px 0 0}.safety-note{border:1px solid #5a4a2b;background:#211b10;color:#d8c69f;padding:15px;border-radius:9px;margin-top:18px;font-size:13px}.print{margin-top:18px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--text);padding:10px 15px}.info{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:35px 0}.info p{font-size:14px}footer{border-top:1px solid var(--line);padding:22px 8vw;color:var(--muted);font-size:12px;display:flex;justify-content:space-between;gap:20px}
@media(max-width:720px){.hero{padding:55px 24px}.section-heading,.info{display:block}.section-heading>p{margin-top:10px}.choices,.role-grid{grid-template-columns:1fr}.step{grid-template-columns:1fr;gap:2px}.week{padding:0}footer{display:block}footer span{display:block;margin-top:6px}}
@media print{body{background:white;color:#111}.hero{padding:20px;background:white;color:#111}.hero p,.section-heading>p,.role-card p,.step p,.info p{color:#333}.panel,.roadmap-box,.role-card{background:white;border-color:#bbb;break-inside:avoid}.panel form,.jump,footer,.info,.print{display:none}.results{padding:10px 0}.role-grid{grid-template-columns:repeat(3,1fr)}}
